# Pusher Channels (Local Docker Soketi)
PUSHER_APP_ID="tricoins-app"
PUSHER_SECRET="tricoins-secret"
NEXT_PUBLIC_PUSHER_KEY="tricoins-key"
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"
