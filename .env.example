NEXT_PUBLIC_PUSHER_USE_TLS="false"
# Untuk Pusher Cloud (Production di Vercel):
# Cukup kosongkan/hapus PUSHER_HOST, PUSHER_PORT, PUSHER_USE_TLS, NEXT_PUBLIC_PUSHER_HOST, dsb
# lalu isi 4 variabel Pusher.com:
# PUSHER_APP_ID="app_id_kamu"
# PUSHER_SECRET="secret_kamu"
# NEXT_PUBLIC_PUSHER_KEY="key_kamu"
# NEXT_PUBLIC_PUSHER_CLUSTER="ap1"

# Vercel Blob Storage (Local Docker Emulator / Cloud)
# Untuk local docker vercel-blob-emulator:
